schema Modules;

// -------------------------------------------------- PHC STEERING AND WEAPONS --------------------------------------------------

// -------------------- PHC HQ (Nexus) --------------------

// ---------- PHC HQ Primary Weapon (4 Laser Turrets) ----------

export ModuleTemplate WEP_PHC_HQ_01_P01 =
{
    .templateID              = "WEP_PHC_HQ_01_P01",
    .name                    = "TXT_WEP_PHC_HQ_01_P01_NAME",
    .description         	 = "TXT_WEP_PHC_HQ_01_P01_DESC",			
    .activateFunction        = "",
    .updateFunction          = "DirectFireTurretWeaponUpdate",
    .moduleFlags             = WeaponModuleFlags.eScanning,
    .templateData            = cons(WeaponModuleTemplate) 
    {
        .cooldown                         = 1.0,
        .numPulsesPerFiring               = 1,
        .durationOrInterpulseCooldown     = 0.5,
        .firingArcYaw                     = 0.01,
        .firingArcPitch                   = 0.01,
        .firingArcYawClamp                = 2.10,
        .firingArcPitchClamp              = 1.70,
        .firingArcTurnRate                = 1.57,
        .minFiringRange                   = 0,
        .maxFiringRange                   = 2000,
        .maxScanRange                     = 2000,
        .projectileName                   = "PRO_PHC_HQ_01_Primary",
        .yawHash                          = "Turret_Yaw_01",                // the named node in the model that corresponds to the yaw of this turret
        .pitchHash                        = "Turret_Pitch_01",              // the named node in the model that corresponds to the pitch of this turret
        .firingNodeHashes                 =                                 // the named node(s) in the model that correspond to the point and direction the projectile will exit the barrel 
        {
            "FX_FireNode_01",
        },
        .targetPriorityByCategory =
        {
            TargetPriorities.High, // Defensive Building
            TargetPriorities.Normal,   // Infantry
            TargetPriorities.Normal,   // Armor
            TargetPriorities.Normal,   // Small Mecha
            TargetPriorities.Normal, // Big Mecha
            TargetPriorities.Ignore, // Air
            TargetPriorities.Ignore, // Drone
            TargetPriorities.Ignore, // Projectile
            TargetPriorities.Low, // Building
            TargetPriorities.Ignore, // Worker
        },
    }
};
