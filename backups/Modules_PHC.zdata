        .firingArcPitchClamp              = 3.14,                           // this has to pitch nearly vertical to hit anything close
        .firingArcTurnRate                = 1.57,
        .minFiringRange                   = 100,
        .maxFiringRange                   = 2500,
        .maxScanRange                     = 2500,
        .scatter                          = 125,			
        .projectileName                   = "PRO_PHC_Defense_Artillery_01_Primary",
