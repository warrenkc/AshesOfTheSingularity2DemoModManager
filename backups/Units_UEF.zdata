// ---------- UEF Starter Unit (Razor Company - Starting Army Only) ----------
export UnitTemplate UNT_UEF_Starter =
{
    .templateHandle = "UNT_UEF_Starter",
    .formationTemplateID = "StarterPatrol",
    .roleFlags  = UnitRoleFlags.eSupport | UnitRoleFlags.eArmor | UnitRoleFlags.eInfantry,
    .templateFlags = UnitTemplateFlags.unbuildable,
    .oreCost    = 400,
    .gasCost    = 0,
    .timeCost   = 40,
    .logCost    = 0,
    .elements   = {
        "ELM_UEF_Recon_02", "ELM_UEF_Recon_02", // Position 0: Rear (Infantry Support Vehicle)
        "ELM_UEF_Swarm_04",  // Position 9: Front center (Razor Company leader)		
        "ELM_UEF_Swarm_05", "ELM_UEF_Swarm_05",  // Positions 2-3: Infantry row 1 
        "ELM_UEF_Swarm_05", "ELM_UEF_Swarm_05",  // Positions 4-5: Infantry row 2 		
        "ELM_UEF_Swarm_02", "ELM_UEF_Swarm_02",  // Positions 6-7: Infantry row 3 left
        "ELM_UEF_Swarm_03", "ELM_UEF_Swarm_03",  // Positions 8-9: Infantry row 3 right
    },
	
	.OrderMoveAudioCue     = { "UEF_Starter_01_Move_01", "UEF_Starter_01_Move_02", "UEF_Starter_01_Move_03", },
    .OrderAttackAudioCue   = { "UEF_Starter_01_Attack_01", "UEF_Starter_01_Attack_02", "UEF_Starter_01_Attack_03", "UEF_Starter_01_Attack_04", "UEF_Starter_01_Attack_05", },
    .OrderPatrolAudioCue   = { "UEF_Starter_01_Patrol_01", "UEF_Starter_01_Patrol_02", "UEF_Starter_01_Patrol_03", },
    .OrderStopAudioCue     = { "UEF_Starter_01_Stop_01", "UEF_Starter_01_Stop_02", "UEF_Starter_01_Stop_03", },
    .OrderInvalidAudioCue  = { "UEF_Starter_01_Invalid_01", "UEF_Starter_01_Invalid_02", "UEF_Starter_01_Invalid_03", },
    .SelectAudioCue        = { "UEF_Starter_01_Select_01", "UEF_Starter_01_Select_02", "UEF_Starter_01_Select_03", },	
};

