{
  "id": "double_extractor_resources",
  "name": "Double Extractor Resources",
  "description": "Doubles the resource output of all extractor-category buildings (ore mines, gas mines, tech labs, logistics depots, refineries, and amplifiers) for both PHC and UEF factions.",
  "version": "1.0",
  "patches": [

    {
      "comment": "PHC Ore Mine: 2.0 -> 4.0 per second",
      "file": "Modules_PHC.zdata",
      "type": "multiply",
      "pattern": "(?s)\\.templateID\\s+=\\s+\"Res_PHC_Ore_Mine\",.*?\\[Players\\.Resource\\.Ore\\]\\s+=\\s+(\\d+\\.\\d+)",
      "factor": 2.0,
      "group": 1
    },
