schema Buildings;

// ---------- PHC Headquarters 01 ----------

export BuildingTemplate bld_PHC_Nexus =
{
    .TemplateID  = "bld_PHC_Nexus",
    .Name        = "TXT_BLD_PHC_HQ_01_NAME",
    .Desc        = "TXT_BLD_PHC_HQ_01_DESC",
    .Asset       = "BLD_PHC_Headquarters_01",
    .iconID      = "BLD_PHC_HQ_01",
    .category    = "HQ",
    .TerrainMod  = "TerrainMod_BLD_Large_01",
    .Flags       = BuildingFlags.regionCenter | BuildingFlags.loseIfKilled,
    .Faction     = Players.playerType.PHC,
    .maxHps      = 10000,
    .maxShields  = 0,
    .healRate    = 40,
    .shieldRate  = 0,
    .targetingRadius = 50.0f,
    .radiusFloraCollider = 192.0f,
    .armor = // each point of armor is ~5% damage reduction from that type of damage (see WeaponDamageTypes)
    {
        1, // Kinetic
        1, // Electromagnetic (EMP)
        1, // Thermal (fire)
        1, // Ionic (NYI - special against shields)
        1, // Explosion (shrapnel, shock)
    },
    .damageThresholds = { 0.9, 0.75, 0.5, 0.25 },
    .radarCrossSection = 160.0f,
    .targetingCategory = Modules.TargetingCategory.DefensiveBuilding,
    .ModuleTree =
    {
        .Modules = 
        {
            { 0, 0xffffffff, "Res_PHC_HQ" },
            { 1, 0xffffffff, "Con_PHC_HQ" },
            { 2, 0xffffffff, "VIS_PHC_HQ" },

            // Controls Queuing for Each Unit Type
            { 3, 0xffffffff, "Con_PHC_Light_Coordination" },
            { 4, 0xffffffff, "Con_PHC_Med_Coordination" },
            { 5, 0xffffffff, "Con_PHC_Heavy_Coordination" },
            { 6, 0xffffffff, "Con_PHC_Air_Coordination" },
            { 7, 0xffffffff, "Con_PHC_Super_Coordination" },			

			// Support for Dev Con All Building
            { 8, 0xffffffff, "DEV_CON_ALL_HELPER" },			
			
			// Weapons (Turrets)
            {  9, 0xffffffff, "WEP_PHC_HQ_01_P01" },
            { 10, 0xffffffff, "WEP_PHC_HQ_01_P02" },
            { 11, 0xffffffff, "WEP_PHC_HQ_01_P03" },
            { 12, 0xffffffff, "WEP_PHC_HQ_01_P04" },
            { 13, 0xffffffff, "WEP_PHC_HQ_01_S01" },
			
			// Workers
            { 14, 0xffffffff, "Worker_HQ_Spawner" },
        },
    },
};

