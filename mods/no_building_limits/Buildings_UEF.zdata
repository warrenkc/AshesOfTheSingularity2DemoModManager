schema Buildings;

// ---------- UEF Headquarters 01 ----------

export BuildingTemplate bld_UEF_HQ =
{
    .TemplateID  = "bld_UEF_HQ",
    .Name        = "TXT_UEF_HQ_NAME",
    .Desc        = "TXT_UEF_HQ_DESC",
    .Asset       = "BLD_UEF_Headquarters_01",
    .iconID      = "BLD_UEF_HQ_01",
    .category    = "HQ",
    .Faction     = Players.playerType.UEF,
    .TerrainMod  = "TerrainMod_BLD_Large_01",
    .Flags       = BuildingFlags.regionCenter | BuildingFlags.loseIfKilled,
    .maxHps      = 10000,
	.healRate	 = 40,	
    .radiusFloraCollider = 160.0f,
    .damageThresholds = { 0.9, 0.75, 0.5, 0.25 },
    .radarCrossSection = 160.0f,
    .targetingRadius = 90.0f,
    .targetingCategory = Modules.TargetingCategory.DefensiveBuilding,
    .ModuleTree  =
    {
        .Modules = 
        {
            { 0, 0xffffffff, "Res_UEF_HQ" },
            { 1, 0xffffffff, "Con_UEF_HQ" },
            { 2, 0xffffffff, "VIS_UEF_HQ" },

            // Controls Queuing for Each Unit Type
            { 3, 0xffffffff, "Con_UEF_Light_Coordination" },
            { 4, 0xffffffff, "Con_UEF_Med_Coordination" },
            { 5, 0xffffffff, "Con_UEF_Heavy_Coordination" },
            { 6, 0xffffffff, "Con_UEF_Air_Coordination" },
            { 7, 0xffffffff, "Con_UEF_Super_Coordination" },			

			// Support for Dev Con All Building
            { 8, 0xffffffff, "DEV_CON_ALL_HELPER" },
			
			// Weapons (Turrets)
            { 9, 0xffffffff, "WEP_UEF_HQ_01_P01" },
            {10, 0xffffffff, "WEP_UEF_HQ_01_P02" },
            {11, 0xffffffff, "WEP_UEF_HQ_01_P03" },
            {12, 0xffffffff, "WEP_UEF_HQ_01_P04" },
			{13, 0xffffffff, "WEP_UEF_HQ_01_S01" },
            {14, 0xffffffff, "WEP_UEF_HQ_01_S02" },
			
			// Workers
            { 15, 0xffffffff, "Worker_HQ_Spawner" },
        },
    },
};

